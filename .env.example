# Copy to .env and adjust. All variables use the SENTINEL_ prefix.

# Capture source: set exactly one of these.
# SENTINEL_INTERFACE=eth0
# SENTINEL_PCAP=./captures/demo.pcap

# Optional libpcap filter.
# SENTINEL_BPF=tcp port 443

# Learning and detection.
SENTINEL_BASELINE_PACKETS=200
SENTINEL_CONTAMINATION=0.02
SENTINEL_COOLDOWN_SECONDS=10
SENTINEL_SEED=42

# Output.
# SENTINEL_ALERT_LOG=./alerts/alerts.jsonl
# SENTINEL_MODEL_PATH=./model.joblib
SENTINEL_LOG_LEVEL=INFO
SENTINEL_JSON_LOGS=false
